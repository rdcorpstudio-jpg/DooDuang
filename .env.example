# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://dooduang-bay.vercel.app

# Firebase Auth (Google login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Search Console (meta tag verification)
GOOGLE_SITE_VERIFICATION=

# SMTP - Hosting Lotus / DirectAdmin
SMTP_HOST=mail.convertaff.com
SMTP_PORT=587
SMTP_USER=noreply@convertaff.com
SMTP_PASS=
EMAIL_FROM=noreply@convertaff.com
SMTP_INSECURE_TLS=true
# SMTP_SECURE=true

# Database - Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dooduang

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Must be Price IDs (price_...), not Product IDs (prod_...)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_POPULAR=price_...
STRIPE_PRICE_PREMIUM=price_...

# OpenAI (optional — fortune falls back to local text if missing)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
