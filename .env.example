# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://dooduang-bay.vercel.app

# Firebase Auth (Google login)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Usually <projectId>.firebaseapp.com — production SDK overrides to the site host
# and next.config proxies /__/auth/* for Safari redirect login.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional override for auth proxy target (defaults to <projectId>.firebaseapp.com)
# FIREBASE_AUTH_PROXY_HOST=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Google Cloud Console → Credentials → OAuth 2.0 Client → Authorized redirect URIs
# must include: https://dooduang-bay.vercel.app/__/auth/handler

# Phone OTP login
# log = print SMS to server logs (dev only)
# boostsms = BoostSMS (https://app.boost-sms.com)
# twilio = Twilio REST
# http = POST { phone, message } to SMS_HTTP_URL
SMS_PROVIDER=boostsms
BOOSTSMS_SECRET_KEY=sk_live_...
# Approved sender name in BoostSMS (max 11 chars) — เมนู "ชื่อผู้ส่ง"
BOOSTSMS_SENDER=
# PHONE_OTP_EXPIRES_SEC=300
# Return OTP in send response — never enable in production
# PHONE_OTP_ECHO=true

# LINE Login (LINE Login channel — not Messaging API)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://maemangmee.com/api/auth/line/callback

# Google Search Console (meta tag verification)
GOOGLE_SITE_VERIFICATION=

# SMTP - Hosting Lotus / DirectAdmin
SMTP_HOST=mail.convertaff.com
SMTP_PORT=587
SMTP_USER=noreply@convertaff.com
SMTP_PASS=
EMAIL_FROM=noreply@convertaff.com
SMTP_INSECURE_TLS=true
# SMTP_SECURE=true

# Database - Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dooduang

# Stripe (https://dashboard.stripe.com)
# Stripe — one-time Price (not recurring) so PromptPay / QR works
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Must be one-time Price IDs (price_...), not Product IDs (prod_...)
STRIPE_PRICE_STARTER=price_...
# Optional alias — preferred if set
# STRIPE_PRICE_ONETIME=price_...
STRIPE_PRICE_POPULAR=price_...
STRIPE_PRICE_PREMIUM=price_...

# OpenAI (optional — fortune falls back to local text if missing)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
